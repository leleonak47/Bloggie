@page
@model Bloggie.Web.Pages.Admin.Blogs.ListModel
@{
}
<div class="bg-secondary bg-opacity-10 py-2 mb-5">
    <div class="container">
        <h1>Blog Post List</h1>

    </div>
</div>

<partial name="_Notification">

@if (Model.ListBlogPost != null && Model.ListBlogPost.Any())
{
    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <td>Id</td>
                    <td>Heading</td>
                    <td>Visible</td>
                    <td></td>
                </tr>
            </thead>
            <tbody>
                @foreach (var blogPost in Model.ListBlogPost)
                {
                    <tr>
                        <td>@blogPost.Id</td>
                        <td>@blogPost.Heading</td>
                        @if (blogPost.Visible)
                        {
                            <td class="text-success">Visivel</td>
                        }
                        else
                        {
                            <td class="text-danger">Invisivel</td>
                        }
                        <td><a href="/Admin/Blogs/Edit/@blogPost.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
}
else
{
    <div class="container">
        <p>Nenhum Blog Post Encontrado!</p>
    </div>
}