@using Bloggie.Web.Models.ViewModels

@{
    var notification = ViewData["Notification"] as Notification;
}

@if (notification is not null)
{
    var notificationClass = notification.Type switch
    {
        Enums.NotificationType.Success => "alert-success",
        Enums.NotificationType.Info => "alert-secondary",
        Enums.NotificationType.Error => "alert-danger",
        _ => ""
    };

    <div class="container mb-5">
        <div class="alert @notificationClass alert-dismissible fade show" role="alert">
            @notification.Message

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fechar">
            </button>
        </div>
    </div>
}